# Mesmo Postgres da API local. O painel abre a sessão em modo sistema.
DATABASE_URL="postgresql://clinic:clinic@127.0.0.1:5433/clinic?sslmode=disable"

# A criação da clínica reusa o POST /api/cadastro da API.
API_URL="http://localhost:3001/api"
LANDING_API_KEY="a-mesma-chave-da-api"

# Login da equipe interna. Não é usuário de clínica.
PANEL_EMAIL="equipe@jaclinics.local"
PANEL_PASSWORD="painel-interno"
PANEL_SECRET="troque-esta-chave-do-painel"
